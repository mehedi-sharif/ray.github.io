---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { formatDate, url } from "@/lib/utils";
import { getPosts, excerpt } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.meta_title ?? post.data.title} description={post.data.description || excerpt(post.body)} image={post.data.image} type="article">
  <article class="wrap pt-20">
    <div class="mx-auto max-w-[680px] text-center">
      <p class="eyebrow">{formatDate(post.data.date)} · <span class="text-accent">{post.data.category}</span></p>
      <h1 class="mt-5 font-display text-display-sm font-black uppercase leading-none tracking-[-0.01em] text-accent md:text-display">{post.data.title}</h1>
    </div>
    <img src={url(post.data.image)} alt="" class="mt-14 aspect-[3/2] w-full rounded-lg object-cover" />
    <div class="prose mx-auto mt-14 max-w-[680px]">
      <Content />
    </div>
    <div class="mx-auto mt-16 max-w-[680px]">
      <a href={url("/#writing")} class="text-base font-medium text-accent hover:underline">← All writing</a>
    </div>
  </article>
</Base>
