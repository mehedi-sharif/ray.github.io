---
import type { CollectionEntry } from "astro:content";
import { formatDate, url } from "@/lib/utils";
const { post, first = false } = Astro.props as { post: CollectionEntry<"blog">; first?: boolean };
---
<a href={url(`/blog/${post.id}`)} class:list={["reveal group grid grid-cols-[1fr_auto] items-start gap-x-6 border-b border-ink/10 pb-[35px] md:grid-cols-[1fr_180px_100px]", first ? "pt-0" : "pt-[80px]"]}>
  <h3 class="text-[20px] font-semibold leading-[1.4] transition-colors group-hover:text-accent">{post.data.title}</h3>
  <p class="text-base font-medium leading-[1.7] text-ink/50 max-md:col-start-1 max-md:row-start-2 max-md:mt-1">{formatDate(post.data.date)}</p>
  <p class="text-right text-base font-medium uppercase leading-[1.7] text-accent max-md:col-start-2 max-md:row-start-1">{post.data.category}</p>
</a>
