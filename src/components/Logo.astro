---
import { config, url } from "@/lib/utils";
---
<a href={url("/")} aria-label="Home" class="absolute left-1/2 top-1/2 flex h-[69px] w-[100px] -translate-x-1/2 -translate-y-1/2 items-center justify-center">
  {config.site.logo ? (
    <img src={url(config.site.logo)} alt={config.site.title} class="max-h-full max-w-full" />
  ) : (
    <svg viewBox="0 0 90 60" class="h-[52px] w-[80px] text-ink" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 10c-2 14-3 28-1 40M13 36c6-10 14-14 16-8 1 5-4 14-10 18 8-2 15-6 20-14" />
      <path d="M40 30c3 10 8 16 13 9 4-6 5-15 4-22-1 9 2 25 9 26 5 0 9-6 12-12" />
      <circle cx="82" cy="46" r="1.6" fill="currentColor" />
    </svg>
  )}
</a>
