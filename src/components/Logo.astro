---
import { config, url } from "@/lib/utils";
---
<a href={url("/")} aria-label="Home" class="logo absolute left-1/2 top-1/2 flex h-[69px] w-[100px] -translate-x-1/2 -translate-y-1/2 items-center justify-center">
  {config.site.logo ? (
    <img src={url(config.site.logo)} alt={config.site.title} class="max-h-full max-w-full" />
  ) : (
    <svg viewBox="0 0 100 64" class="h-[56px] w-[88px] overflow-visible text-ink" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Ray">
      <!-- R: stem, bowl and leg -->
      <path class="sig" style="--d:0s;--t:.35s" pathLength="1" d="M16 12c-1 12-2 24-3 36" />
      <path class="sig" style="--d:.3s;--t:.55s" pathLength="1" d="M15 15c8-5 18-4 18 3 0 7-9 11-18 11 6 3 11 10 16 17 2 3 5 3 7 0" />
      <!-- a -->
      <path class="sig" style="--d:.8s;--t:.5s" pathLength="1" d="M48 34c-3-4-10-2-11 4-1 6 5 8 9 2l2-6c-1 5-1 10 2 11 2 0 4-2 5-4" />
      <!-- y -->
      <path class="sig" style="--d:1.25s;--t:.75s" pathLength="1" d="M55 32c0 6 1 11 5 11 4 0 6-5 7-11 0 11-1 19-6 23-4 3-9 1-7-3 2-5 13-9 24-15" />
      <!-- flourish dot -->
      <circle class="sig-dot" cx="84" cy="44" r="1.8" fill="currentColor" stroke="none" />
    </svg>
  )}
</a>

<style>
  .sig { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .sig-dot { opacity: 0; transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: reduce) {
    .sig { stroke-dashoffset: 0; }
    .sig-dot { opacity: 1; }
  }
</style>

<script>
  // Continuously write the signature stroke by stroke, hold, fade out, repeat.
  const svg = document.querySelector<SVGSVGElement>(".logo svg");
  if (svg && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const strokes = [...svg.querySelectorAll<SVGPathElement>(".sig")];
    const dot = svg.querySelector<SVGCircleElement>(".sig-dot");
    const ease = "cubic-bezier(.55,.1,.35,1)";
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const loop = async () => {
      while (true) {
        svg.style.opacity = "1";
        strokes.forEach((p) => (p.style.strokeDashoffset = "1"));
        if (dot) dot.style.opacity = "0";

        for (const p of strokes) {
          const duration = parseFloat(p.style.getPropertyValue("--t")) * 1000 || 500;
          await p.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration, easing: ease, fill: "forwards" }).finished;
          p.style.strokeDashoffset = "0";
        }
        if (dot) {
          await dot.animate([{ opacity: 0, transform: "scale(0)" }, { opacity: 1, transform: "scale(1)" }], { duration: 300, easing: "ease-out", fill: "forwards" }).finished;
          dot.style.opacity = "1";
        }

        await wait(2200);
        await svg.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 500, fill: "forwards" }).finished;
        svg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
        svg.style.opacity = "0";
        await wait(300);
      }
    };
    loop();
  } else if (svg) {
    svg.querySelectorAll<SVGPathElement>(".sig").forEach((p) => (p.style.strokeDashoffset = "0"));
  }
</script>
