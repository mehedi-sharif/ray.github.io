---
const { items } = Astro.props as { items: { value: string; label: string }[] };
---
<div class="grid grid-cols-2 gap-y-10 md:grid-cols-[288px_320px_1fr]">
  {items.map((item, i) => (
    <div class:list={["reveal text-accent", i % 3 !== 0 && "md:border-l md:border-ink/10 md:pl-8", i % 2 === 1 && "max-md:border-l max-md:border-ink/10 max-md:pl-6"]}>
      <p class="text-[44px] font-semibold leading-[1.2] md:text-[60px]">{item.value}</p>
      <p class="mt-4 max-w-[118px] text-[18px] leading-[1.2]">{item.label}</p>
    </div>
  ))}
</div>
