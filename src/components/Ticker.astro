---
import Star from "@/components/Star.astro";
interface Props { words: string[]; direction?: "left" | "right"; size?: "md" | "lg"; links?: (string | undefined)[]; starClass?: string; newTab?: boolean }
const { words, direction = "left", size = "md", links = [], starClass = "text-ink/10", newTab = true } = Astro.props;
const loop = [...words, ...words, ...words, ...words];
const text = size === "lg" ? "text-mega-sm md:text-mega leading-[0.9375]" : "text-ticker-sm md:text-ticker leading-[1.3]";
const star = size === "lg" ? "h-8 w-8 md:h-14 md:w-14" : "h-6 w-6 md:h-9 md:w-9";
---
<div class="flex overflow-hidden whitespace-nowrap [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]">
  <div class:list={["flex shrink-0 items-center", direction === "left" ? "ticker-left" : "ticker-right"]}>
    {[0, 1].map(() => loop.map((w, i) => {
      const href = links[i % words.length];
      const cls = `font-display ${text} font-black uppercase text-accent`;
      return (
        <span class="flex items-center">
          {href ? <a href={href} target={newTab ? "_blank" : undefined} rel={newTab ? "noopener" : undefined} class={`${cls} transition-opacity hover:opacity-70`}>{w}</a> : <span class={cls}>{w}</span>}
          <Star class={`mx-5 md:mx-5 ${star} ${starClass}`} />
        </span>
      );
    }))}
  </div>
</div>
